{
  "manifest_version": 3,
  "name": "UOM 助手 v1.4",
  "version": "1.4.0",
  "version_name": "v1.4",
  "description": "验证码自动填入与确认、培训助手、姓名水印隐私保护",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://uom.caac.gov.cn/*",
    "http://127.0.0.1:8899/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js"
      ],
      "matches": [
        "https://uom.caac.gov.cn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://uom.caac.gov.cn/*"
      ],
      "js": [
        "watermark_privacy.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://uom.caac.gov.cn/*"
      ],
      "js": [
        "content_bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_end",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://uom.caac.gov.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UOM 助手"
  },
  "minimum_chrome_version": "111"
}
